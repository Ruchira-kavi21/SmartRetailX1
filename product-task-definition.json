{
  "family": "smartretailx-product-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::134014260827:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "product-service",
      "image": "134014260827.dkr.ecr.ap-southeast-1.amazonaws.com/smartretailx/product-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5002,
          "hostPort": 5002,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MYSQL_HOST",
          "value": "smartretailx-mysql-new.c1ikaaio4yoz.ap-southeast-1.rds.amazonaws.com"
        },
        {
          "name": "MYSQL_PORT",
          "value": "3306"
        },
        {
          "name": "MYSQL_USER",
          "value": "root"
        },
        {
          "name": "MYSQL_PASSWORD",
          "value": "rootpassword"
        },
        {
          "name": "MYSQL_DATABASE",
          "value": "product_db"
        },
        {
          "name": "DATABASE_URL",
          "value": "mysql://root:rootpassword@smartretailx-mysql-new.c1ikaaio4yoz.ap-southeast-1.rds.amazonaws.com:3306/product_db"
        },
        {
          "name": "JWT_SECRET",
          "value": "change-this-development-secret"
        },
        {
          "name": "PORT",
          "value": "5002"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/smartretailx/product-service",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}