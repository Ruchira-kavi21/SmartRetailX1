{
  "family": "smartretailx-inventory-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::134014260827:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "inventory-service",
      "image": "134014260827.dkr.ecr.ap-southeast-1.amazonaws.com/smartretailx/inventory-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5004,
          "hostPort": 5004,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MYSQL_HOST",
          "value": "smartretailx-mysql-new.c1ikaaio4yoz.ap-southeast-1.rds.amazonaws.com"
        },
        {
          "name": "MYSQL_PORT",
          "value": "3306"
        },
        {
          "name": "MYSQL_USER",
          "value": "admin"
        },
        {
          "name": "MYSQL_PASSWORD",
          "value": "Lakmal2005"
        },
        {
          "name": "MYSQL_DATABASE",
          "value": "inventory_db"
        },
        {
          "name": "DATABASE_URL",
          "value": "mysql://admin:Lakmal2005@smartretailx-mysql-new.c1ikaaio4yoz.ap-southeast-1.rds.amazonaws.com:3306/inventory_db"
        },
        {
          "name": "JWT_SECRET",
          "value": "change-this-development-secret"
        },
        {
          "name": "PORT",
          "value": "5004"
        }
      ]
    }
  ]
}