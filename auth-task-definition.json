{
  "family": "smartretailx-auth-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::134014260827:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "auth-service",
      "image": "134014260827.dkr.ecr.ap-southeast-1.amazonaws.com/smartretailx/auth-service:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 5001, "hostPort": 5001, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "MYSQL_HOST", "value": "smartretailx-mysql-new.c1ikaaio4yoz.ap-southeast-1.rds.amazonaws.com" },
        { "name": "MYSQL_PORT", "value": "3306" },
        { "name": "MYSQL_USER", "value": "admin" },
        { "name": "MYSQL_PASSWORD", "value": "Lakmal2005" },
        { "name": "MYSQL_DATABASE", "value": "auth_db" },
        { "name": "DATABASE_URL", "value": "mysql://admin:Lakmal2005@smartretailx-mysql-new.c1ikaaio4yoz.ap-southeast-1.rds.amazonaws.com:3306/auth_db" },
        { "name": "JWT_SECRET", "value": "change-this-development-secret" },
        { "name": "PORT", "value": "5001" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/smartretailx/auth-service",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}